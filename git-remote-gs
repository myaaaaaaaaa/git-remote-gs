#!/usr/bin/env bash
# git-remote-gs: Minimalist GCS Git remote using set -ex and jq
set -ex

REMOTE_URL="$2"
CACHE_DIR=$(mktemp -d -t git-remote-gs.XXXXXX)
BUNDLE_FILE="${CACHE_DIR}/repo.bundle"
FETCH_FILE="${CACHE_DIR}/fetch"
PUSH_FILE="${CACHE_DIR}/push"

trap 'rm -rf "$CACHE_DIR"' EXIT

if ! command -v blobcp >/dev/null 2>&1; then
	blobcp() {
		gcloud storage cp --quiet "$@" >&2
	}
fi

download_bundle() {
	[[ -f "$BUNDLE_FILE" ]] && return 0
	local gz_file="${BUNDLE_FILE}.gz"
	blobcp "$REMOTE_URL" "$gz_file" || true
	if [[ -f "$gz_file" ]]; then
		gzip -d "$gz_file"
		git fetch --quiet "$BUNDLE_FILE" 2>/dev/null || true
	fi
}

cmd_capabilities() {
	echo fetch
	echo push
	echo
}

cmd_list() {
	download_bundle
	[[ -f "$BUNDLE_FILE" ]] && git bundle list-heads "$BUNDLE_FILE"
	echo ""
}

cmd_fetch() {
	download_bundle
}

cmd_push() {
	local new_bundle="${CACHE_DIR}/new.bundle"
	
	git bundle create "$new_bundle" --all
	gzip "$new_bundle"
	blobcp "${new_bundle}.gz" "$REMOTE_URL"

	jq -rR 'split(":") | last | "ok \(.)"' "$PUSH_FILE"
}

cmd_process_batch() {
	for op in fetch push; do
		local file="${CACHE_DIR}/${op}"
		if [[ -f "$file" ]]; then
			"cmd_${op}"
			echo
			rm -f "$file"
		fi
	done
}

# Git communicates with helpers line-by-line over stdin/stdout:
# * 'capabilities': Helper reports capabilities, ending with a blank line.
# * 'list' / 'list for-push': Helper reports '<sha> <ref>' lines, ending with a blank line.
# * 'fetch' / 'push': Sent in batches terminated by a blank line; helper executes
#   the batch, emits acknowledgments ('ok <ref>' for push), and ends with a blank line.
# * EOF on stdin signals helper termination.
#
# Example exchange (Fetch / Clone):
#   git:    capabilities
#   helper: fetch
#           push
#           (blank)
#   git:    list
#   helper: <sha> refs/heads/main
#           <sha> HEAD
#           (blank)
#   git:    fetch <sha> HEAD
#           fetch <sha> refs/heads/main
#           (blank)
#   helper: (blank)
#
# Example exchange (Push):
#   git:    capabilities
#   helper: fetch
#           push
#           (blank)
#   git:    list for-push
#   helper: (blank)
#   git:    push refs/heads/main:refs/heads/main
#           (blank)
#   helper: ok refs/heads/main
#           (blank)
#
# --- Main Event Router ---
while read -r cmd args; do
	if [[ -z "$cmd" ]]; then
		cmd_process_batch
		continue
	fi

	case "$cmd" in
		capabilities) cmd_capabilities ;;
		list)         cmd_list ;;
		fetch)        echo "$args" >> "$FETCH_FILE" ;;
		push)         echo "$args" >> "$PUSH_FILE" ;;
	esac
done

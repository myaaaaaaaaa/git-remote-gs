#!/usr/bin/env bash
# git-remote-gs: Minimalist GCS Git remote using set -ex and jq
set -ex

REMOTE_URL="$2"
CACHE_DIR=$(mktemp -d -t git-remote-gs.XXXXXX)
BUNDLE_FILE="${CACHE_DIR}/repo.bundle"
BATCH_FILE="${CACHE_DIR}/batch"

trap 'rm -rf "$CACHE_DIR"' EXIT

blobcp() {
	gsutil -q cp "$@" >&2
}

download_bundle() {
	[[ -f "$BUNDLE_FILE" ]] && return 0
	blobcp "$REMOTE_URL" "$BUNDLE_FILE" || true
}

cmd_capabilities() {
	echo fetch
	echo push
	echo
}

cmd_list() {
	download_bundle
	[[ -f "$BUNDLE_FILE" ]] && git bundle list-heads "$BUNDLE_FILE"
	echo ""
}

cmd_fetch() {
	download_bundle
	# jq parses the whole batch file, extracts all target refs (col 3), 
	# and $() flattens them into arguments for a single bulk fetch operation.
	refs=$(jq -rR 'split(" ")[2]' "$BATCH_FILE")
	# shellcheck disable=SC2086
	git fetch --quiet "$BUNDLE_FILE" $refs
}

cmd_push() {
	local new_bundle="${CACHE_DIR}/new.bundle"
	
	git bundle create "$new_bundle" --all
	blobcp "$new_bundle" "$REMOTE_URL"

	# jq extracts the dst ref from src:dst (col 2), formats the ACK, and prints to stdout
	jq -rR 'split(" ")[1] | split(":") | last | "ok \(.)"' "$BATCH_FILE"
}

cmd_process_batch() {
	[[ -s "$BATCH_FILE" ]] || return 0

	# jq slurps (-s) the file, grabs the first line, and extracts the first word to route the command
	local batch_type
	batch_type=$(jq -sRr 'split("\n")[0] | split(" ")[0]' "$BATCH_FILE")

	# Dynamically route to cmd_fetch or cmd_push
	"cmd_${batch_type}"
	echo

	rm -f "$BATCH_FILE"
}

# Git communicates with helpers line-by-line over stdin/stdout:
# * 'capabilities': Helper reports capabilities, ending with a blank line.
# * 'list' / 'list for-push': Helper reports '<sha> <ref>' lines, ending with a blank line.
# * 'fetch' / 'push': Sent in batches terminated by a blank line; helper executes
#   the batch, emits acknowledgments ('ok <ref>' for push), and ends with a blank line.
# * EOF on stdin signals helper termination.
#
# Example exchange (Fetch / Clone):
#   git:    capabilities
#   helper: fetch
#           push
#           (blank)
#   git:    list
#   helper: <sha> refs/heads/main
#           <sha> HEAD
#           (blank)
#   git:    fetch <sha> HEAD
#           fetch <sha> refs/heads/main
#           (blank)
#   helper: (blank)
#
# Example exchange (Push):
#   git:    capabilities
#   helper: fetch
#           push
#           (blank)
#   git:    list for-push
#   helper: (blank)
#   git:    push refs/heads/main:refs/heads/main
#           (blank)
#   helper: ok refs/heads/main
#           (blank)
#
# --- Main Event Router ---
while read -r line; do
	if [[ -z "$line" ]]; then
		cmd_process_batch
		continue
	fi

	case "$line" in
		capabilities) cmd_capabilities ;;
		list*)        cmd_list ;;
		fetch\ *|push\ *) echo "$line" >> "$BATCH_FILE" ;;
	esac
done
